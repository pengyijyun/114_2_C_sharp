using System;
using System.IO;
using System.Drawing;
using System.Windows.Forms;

namespace 吃角子老虎機
{
    public partial class Form1 : Form
    {
        // 程式狀態變數
        private Random rand;
        private int n1, n2, n3;
        private int prize = 0;
        private int balance = 0;
        private int totalDeposited = 0;
        private int totalSpins = 0;
        private int winCount = 0;

        // 動畫與儲存相關狀態
        private System.Windows.Forms.Timer spinTimer;
        private int spinTick;
        private int lastBet;
        private bool pb1Stopped;
        private bool pb2Stopped;
        private bool pb3Stopped;
        private const int TICKS_STOP_PB1 = 10; // ~800ms
        private const int TICKS_STOP_PB2 = 17; // ~1360ms
        private const int TICKS_STOP_PB3 = 24; // ~1920ms

        private static string SAVE_FILE => Path.Combine(Application.StartupPath, "savegame.txt");

        public Form1()
        {
            InitializeComponent();
        }

        private void Form1_Load(object sender, EventArgs e)
        {
            // 先嘗試載入舊存檔
            LoadGame();

            // 初始化動畫 Timer
            spinTimer = new System.Windows.Forms.Timer();
            spinTimer.Interval = 80;
            spinTimer.Tick += spinTimer_Tick;

            rand = new Random();
            // 確保預設選項
            if (comboBox_bet.Items.Count > 0)
            {
                comboBox_bet.SelectedIndex = 0;
            }

            // 確保 ImageList 有圖片，否則嘗試從專案資料夾載入
            EnsureImagesLoaded();

            // 啟動時不顯示水果圖片，直到使用者按下「旋轉」按鈕
            if (pictureBox1 != null) pictureBox1.Image = null;
            if (pictureBox2 != null) pictureBox2.Image = null;
            if (pictureBox3 != null) pictureBox3.Image = null;

            UpdateUI();
            UpdateStats();
        }

        // 如果 Designer 的 imageList1 沒有圖片，嘗試從使用者指定或常見的資料夾載入
        private void EnsureImagesLoaded()
        {
            if (imageList1 == null) return;
            if (imageList1.Images.Count > 0) return;

            try
            {
                string baseDir = Application.StartupPath;

                // 優先候選資料夾（使用者提供的絕對路徑、執行目錄下的 imageList，以及舊的 Images\Fruit Symbols）
                var candidates = new[]
                {
                    // 使用者指定的完整路徑
                    @"C:\Users\m303\Desktop\114_2_C_sharp\115_05_07\吃角子老虎機\bin\Debug\imageList",
                    // 執行目錄下的 imageList (通常為 bin\Debug\imageList)
                    Path.Combine(baseDir, "imageList"),
                    // 舊的 Images\Fruit Symbols 路徑
                    Path.Combine(baseDir, "Images", "Fruit Symbols"),
                    // 專案相對路徑的候選（開發機環境）
                    Path.Combine(Directory.GetParent(baseDir)?.FullName ?? baseDir, "Images", "Fruit Symbols")
                };

                string folder = null;
                foreach (var c in candidates)
                {
                    if (string.IsNullOrEmpty(c)) continue;
                    if (Directory.Exists(c))
                    {
                        folder = c;
                        break;
                    }
                }

                if (string.IsNullOrEmpty(folder)) return;

                // 設定 ImageList 的大小為 PictureBox 的大小，確保顯示比例正確
                if (pictureBox1 != null)
                {
                    imageList1.ImageSize = new Size(pictureBox1.Width, pictureBox1.Height);
                }

                string[] exts = new[] { "*.png", "*.bmp", "*.jpg", "*.jpeg", "*.gif" };
                foreach (var ext in exts)
                {
                    foreach (var file in Directory.GetFiles(folder, ext))
                    {
                        try
                        {
                            using (var bmp = new Bitmap(file))
                            {
                                // Clone to avoid file lock
                                imageList1.Images.Add(new Bitmap(bmp));
                            }
                        }
                        catch
                        {
                            // 忽略單一檔案錯誤
                        }
                    }
                }
            }
            catch
            {
                // 保持安靜，若載入失敗則不影響其他功能
            }
        }

        private void button_deposit_Click(object sender, EventArgs e)
        {
            if (!int.TryParse(textBox_deposit.Text.Trim(), out int amount) || amount <= 0)
            {
                MessageBox.Show("請輸入有效的存入金額（必須為正整數）", "錯誤", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            balance += amount;
            totalDeposited += amount;
            textBox_deposit.Clear();
            UpdateUI();

            // 存檔以防資料遺失
            SaveGame();
        }

        private void comboBox_bet_SelectedIndexChanged(object sender, EventArgs e)
        {
            // 若動畫進行中，不變更可用性
            if (spinTimer != null && spinTimer.Enabled) return;
            UpdateUI();
        }

        private void spinTimer_Tick(object? sender, EventArgs e)
        {
            spinTick++;

            // 尚未停止的轉輪顯示隨機圖片
            if (!pb1Stopped)
            {
                int idx = rand.Next(0, Math.Max(1, imageList1.Images.Count));
                pictureBox1.Image = imageList1.Images[idx % imageList1.Images.Count];
            }
            if (!pb2Stopped)
            {
                int idx = rand.Next(0, Math.Max(1, imageList1.Images.Count));
                pictureBox2.Image = imageList1.Images[idx % imageList1.Images.Count];
            }
            if (!pb3Stopped)
            {
                int idx = rand.Next(0, Math.Max(1, imageList1.Images.Count));
                pictureBox3.Image = imageList1.Images[idx % imageList1.Images.Count];
            }

            // 判斷停止時機
            if (!pb1Stopped && spinTick >= TICKS_STOP_PB1)
            {
                pb1Stopped = true;
                if (imageList1.Images.Count > 0) pictureBox1.Image = imageList1.Images[n1 % imageList1.Images.Count];
            }

            if (!pb2Stopped && spinTick >= TICKS_STOP_PB2)
            {
                pb2Stopped = true;
                if (imageList1.Images.Count > 0) pictureBox2.Image = imageList1.Images[n2 % imageList1.Images.Count];
            }

            if (!pb3Stopped && spinTick >= TICKS_STOP_PB3)
            {
                pb3Stopped = true;
                if (imageList1.Images.Count > 0) pictureBox3.Image = imageList1.Images[n3 % imageList1.Images.Count];

                // 全部停止，結束動畫
                spinTimer?.Stop();

                // 判斷勝負並更新數據
                prize = checkWinner(lastBet);
                totalSpins++;

                // 儲存遊戲狀態
                SaveGame();

                // 更新介面
                UpdateUI();
                UpdateStats();
            }
        }

        private void button1_Click(object sender, EventArgs e)
        {
            int bet = GetBetAmount();
            if (bet <= 0) return;
            if (balance < bet) return;

            // 扣款並記錄下注金額（給動畫結束後的判斷使用）
            balance -= bet;
            lastBet = bet;

            // 預先決定最終結果
            n1 = rand.Next(0, 10);
            n2 = rand.Next(0, 10);
            n3 = rand.Next(0, 10);

            // 初始化動畫狀態
            spinTick = 0;
            pb1Stopped = pb2Stopped = pb3Stopped = false;

            // 啟動動畫
            spinTimer?.Start();

            // 更新 UI（按鈕停用）
            UpdateUI();
        }

        private void button2_Click(object sender, EventArgs e)
        {
            int netGain = balance - totalDeposited;
            string profitLabel = netGain >= 0 ? "獲利：" : "虧損：";
            string profitAmount = Math.Abs(netGain).ToString("c");

            string msg = $"累計存入：{totalDeposited.ToString("c")}\r\n目前餘額：{balance.ToString("c")}\r\n{profitLabel}{profitAmount}\r\n\r\n旋轉次數：{totalSpins} 次　中獎次數：{winCount} 次";
            MessageBox.Show(msg, "結算摘要", MessageBoxButtons.OK, MessageBoxIcon.Information);
            this.Close();
        }

        private int GetBetAmount()
        {
            if (comboBox_bet.SelectedItem == null) return 0;
            string s = comboBox_bet.SelectedItem.ToString();
            s = s.Replace("$", "").Trim();
            if (int.TryParse(s, out int bet)) return bet;
            return 0;
        }

        private void getImage()
        {
            if (imageList1 == null)
            {
                pictureBox1.Image = null;
                pictureBox2.Image = null;
                pictureBox3.Image = null;
                return;
            }

            int maxIndex = Math.Max(0, imageList1.Images.Count - 1);
            // 如果 imageList1 沒有圖片，避免例外
            if (imageList1.Images.Count == 0)
            {
                pictureBox1.Image = null;
                pictureBox2.Image = null;
                pictureBox3.Image = null;
                // 仍決定索引為 0..9 以配合內部邏輯
                n1 = rand.Next(0, 10);
                n2 = rand.Next(0, 10);
                n3 = rand.Next(0, 10);
                return;
            }

            // 隨機 0..9
            n1 = rand.Next(0, 10);
            n2 = rand.Next(0, 10);
            n3 = rand.Next(0, 10);

            // 若 imageList 實際數量不足，使用模數選擇存在的圖片
            pictureBox1.Image = imageList1.Images[n1 % imageList1.Images.Count];
            pictureBox2.Image = imageList1.Images[n2 % imageList1.Images.Count];
            pictureBox3.Image = imageList1.Images[n3 % imageList1.Images.Count];
        }

        private int checkWinner(int bet)
        {
            int result = 0;
            if (n1 == n2 && n2 == n3)
            {
                // 頭獎
                result = bet * 10;
            }
            else if (n1 == n2 || n1 == n3 || n2 == n3)
            {
                // 普獎
                result = bet * 2;
            }
            else
            {
                result = 0;
            }

            if (result > 0)
            {
                winCount++;
                balance += result;
            }

            return result;
        }

        private void UpdateUI()
        {
            label_balance.Text = "餘額：" + balance.ToString("c");
            label_lastWin.Text = "本次獲得：" + prize.ToString("c");

            int bet = GetBetAmount();
            // 若動畫進行中，保持旋轉按鈕停用
            if (spinTimer != null && spinTimer.Enabled)
            {
                button1.Enabled = false;
            }
            else
            {
                if (bet <= 0) button1.Enabled = false;
                else button1.Enabled = balance >= bet;
            }
        }

        private void UpdateStats()
        {
            label_totalSpins.Text = "旋轉：" + totalSpins + " 次";
            label_winCount.Text = "中獎：" + winCount + " 次";

            double rate = 0.0;
            if (totalSpins > 0)
            {
                rate = (double)winCount / totalSpins * 100.0;
            }

            label_winRate.Text = "勝率：" + rate.ToString("F1") + "%";
        }

        private void label_winRate_Click(object sender, EventArgs e)
        {

        }

        private void SaveGame()
        {
            try
            {
                var lines = new[]
                {
                    "balance=" + balance,
                    "totalDeposited=" + totalDeposited,
                    "totalSpins=" + totalSpins,
                    "winCount=" + winCount
                };
                File.WriteAllLines(SAVE_FILE, lines);
            }
            catch
            {
                // 忽略寫入失敗
            }
        }

        private void LoadGame()
        {
            try
            {
                if (!File.Exists(SAVE_FILE)) return;
                var lines = File.ReadAllLines(SAVE_FILE);
                foreach (var line in lines)
                {
                    if (string.IsNullOrWhiteSpace(line)) continue;
                    var parts = line.Split('=', 2);
                    if (parts.Length != 2) continue;
                    var key = parts[0].Trim();
                    var val = parts[1].Trim();
                    if (key == "balance" && int.TryParse(val, out int b)) balance = b;
                    else if (key == "totalDeposited" && int.TryParse(val, out int td)) totalDeposited = td;
                    else if (key == "totalSpins" && int.TryParse(val, out int ts)) totalSpins = ts;
                    else if (key == "winCount" && int.TryParse(val, out int wc)) winCount = wc;
                }
            }
            catch
            {
                // 讀取或格式錯誤時重置數值
                balance = 0;
                totalDeposited = 0;
                totalSpins = 0;
                winCount = 0;
            }
        }

        private void Form1_FormClosing(object? sender, FormClosingEventArgs e)
        {
            SaveGame();
        }
    }
}

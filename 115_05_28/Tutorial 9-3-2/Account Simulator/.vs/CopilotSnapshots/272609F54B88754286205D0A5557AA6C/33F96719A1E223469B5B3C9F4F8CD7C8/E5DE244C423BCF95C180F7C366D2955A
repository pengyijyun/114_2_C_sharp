        }

        private void textBox4_TextChanged(object sender, EventArgs e)
        {
            if (decimal.TryParse(balanceTextBox.Text, out decimal amount))
                {
                string accountNumber = accountNumberTextBox.Text;
                string name = nameTextBox.Text;
                account = new BankAccount(accountNumber, name, amount);
                balanceLabel.Text = accountNumber + "\n"
                    + name + "\n" 
                    + account.Balance.ToString("C");

                accountNumberTextBox.Clear();
                nameTextBox.Clear();
                balanceTextBox.Clear();
                depositGroupBox.Visible = true;
                withdrawGroupBox.Visible = true;
            }
            else
            {
                MessageBox.Show("請輸入有效的初始餘額。", "輸入錯誤", MessageBoxButtons.OK, MessageBoxIcon.Warning);
            }

        }

